{
  "name": "@clipsubtitles/storage",
  "version": "0.1.0",
  "private": true,
  "description": "SQLite and PostgreSQL persistence foundations, repositories, durable task queue, credit ledger, idempotency, audit, object store",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:postgres": "vitest run src/postgres.integration.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.910.0",
    "@aws-sdk/lib-storage": "^3.910.0",
    "@aws-sdk/s3-request-presigner": "^3.910.0",
    "@clipsubtitles/contracts": "workspace:*",
    "@clipsubtitles/core": "workspace:*",
    "@google-cloud/storage": "^7.18.0",
    "pg": "^8.23.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
