# INACTIVE PREPARATION TEMPLATE. Do not rename/apply without the cutover review in
# docs/directory/whisper-provider-preparation.md. No secret value belongs here.
# These declarations belong in variables.tf after authorization. The secret must
# already exist in this project's Secret Manager; do not create a provider key.
variable "openai_api_key_secret_id" {
  type        = string
  description = "Existing authorized AppAgentic OpenAI API secret ID (not its value)"
}
variable "openai_api_key_secret_version" {
  type        = string
  description = "Pinned numeric Secret Manager version approved for the worker"
  validation {
    condition     = can(regex("^[1-9][0-9]*$", var.openai_api_key_secret_version))
    error_message = "Pin an explicit numeric version."
  }
}
