# ClipSubtitles local configuration.
# Copy to `.env` for local development. Never commit real secrets.
# Every provider/auth integration is config-gated: with the defaults below the
# whole product runs locally with mock identity and mock transcription.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# Base directory for the SQLite database, object store, and render scratch.
DATA_DIR=.data
# Public origins (used for redirects, signed URLs, OAuth metadata).
API_PORT=3101
API_PUBLIC_URL=http://localhost:3101
WEB_PORT=3100
WEB_PUBLIC_URL=http://localhost:3100

# ---------------------------------------------------------------------------
# Auth (WorkOS/AuthKit is the sole identity + OAuth authority in production)
# ---------------------------------------------------------------------------
# mock  -> local dev users, HS256 bearer tokens minted by `pnpm dev:token`
# workos -> AuthKit hosted sign-in + AuthKit-issued OAuth 2.1 bearer tokens
AUTH_MODE=mock
# Secret used to sign local sessions / mock tokens (>= 32 chars). Local only.
AUTH_LOCAL_SECRET=local-dev-secret-change-me-please-0123456789
# Required only when AUTH_MODE=workos
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_AUTHKIT_ISSUER=
# Must be on the WEB origin (the web app proxies /auth/* to the API) so the session cookie is set for the site.
WORKOS_REDIRECT_URI=http://localhost:3100/auth/callback
WORKOS_WEBHOOK_SECRET=
WORKOS_COOKIE_PASSWORD=

# ---------------------------------------------------------------------------
# Transcription providers (all optional; mock is the local default)
# ---------------------------------------------------------------------------
# Ordered fallback chain. Unconfigured live providers are skipped with a
# recorded reason; fallback never mutates an existing transcript.
TRANSCRIPTION_PROVIDERS=mock
GEMINI_API_KEY=
GEMINI_TRANSCRIBE_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_SCRIBE_MODEL=scribe_v2
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
WHISPER_API_MODEL=whisper-1

# ---------------------------------------------------------------------------
# Rendering
# ---------------------------------------------------------------------------
# ffmpeg -> canvas rasterizer + ffmpeg compositor (deterministic, no Chromium)
# remotion -> Remotion composition (requires Chromium download on first run)
RENDERER=ffmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---------------------------------------------------------------------------
# Limits and retention
# ---------------------------------------------------------------------------
MAX_UPLOAD_BYTES=524288000
MAX_SOURCE_DURATION_SECONDS=600
MAX_REMOTE_SOURCE_BYTES=524288000
ALLOW_PRIVATE_SOURCE_URLS=false
SOURCE_RETENTION_DAYS=30
EXPORT_RETENTION_DAYS=7
SIGNED_URL_TTL_SECONDS=900
QUOTE_TTL_SECONDS=900
RATE_LIMIT_PER_MINUTE=120
INITIAL_CREDIT_GRANT=500
# Proxies (IPs or CIDRs, comma-separated) whose X-Forwarded-For / X-Real-IP headers are
# trusted for client-IP rate limiting. Empty = never trust forwarding headers (fail closed).
TRUSTED_PROXIES=
