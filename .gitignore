# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
.next/
out/
*.tsbuildinfo

# Local runtime data (SQLite DB, object store, render scratch)
.data/
.clipsubtitles/

# Generated fixtures and benchmark outputs (regenerable via `pnpm fixtures:build`)
fixtures/generated/
fixtures/benchmark/reports/*.json
fixtures/benchmark/reports/*.md
!fixtures/benchmark/reports/.gitkeep

# Environment / secrets — never commit
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Logs & coverage
*.log
coverage/

# Remotion / Chromium caches
.remotion/

# Synced caption font files (copied from node_modules by apps/web/scripts/sync-fonts.mjs)
apps/web/public/fonts/

# Playwright artifacts
apps/web/e2e/.results/
apps/web/test-results/
